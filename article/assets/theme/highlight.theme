    "Attribute": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "BaseN": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "BuiltIn": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "CharTok": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Comment": { "text-color": "#808080", "bold": false, "italic": true, "underline": false },
    "CommentVar": { "text-color": "#808080", "bold": false, "italic": true, "underline": false },
    "Constant": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "ControlFlow": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "DataType": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "DecVal": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Documentation": { "text-color": "#808080", "bold": false, "italic": true, "underline": false },
    "Error": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": true },
    "Extension": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "Float": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Function": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Import": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "Information": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "Keyword": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "Operator": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "Other": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Preprocessor": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false },
    "RegionMarker": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "SpecialChar": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "SpecialString": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "String": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Variable": { "text-color": "#ffffff", "bold": false, "italic": false, "underline": false },
    "VerbatimString": { "text-color": "#cccccc", "bold": false, "italic": false, "underline": false },
    "Warning": { "text-color": "#ffffff", "bold": true, "italic": false, "underline": false }
  }
}
